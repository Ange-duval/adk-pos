<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="station_kitchen" model="adk.pos.station">
            <field name="name">Cuisine</field>
            <field name="sequence">1</field>
            <field name="color">2</field>
            <field name="config_ids" eval="[(6, 0, [ref('config_restaurant'), ref('config_cafe')])]"/>
            <field name="category_ids" eval="[(6, 0, [ref('categ_plats'), ref('categ_desserts')])]"/>
        </record>
        <record id="station_bar" model="adk.pos.station">
            <field name="name">Bar</field>
            <field name="sequence">2</field>
            <field name="color">4</field>
            <field name="config_ids" eval="[(6, 0, [ref('config_restaurant'), ref('config_cafe')])]"/>
            <field name="category_ids" eval="[(6, 0, [ref('categ_boissons')])]"/>
        </record>
    </data>
</odoo>
