            <field name="pos_type">restaurant</field>
            <field name="color">4</field>
            <field name="sequence">2</field>
            <field name="category_ids" eval="[(6, 0, [ref('categ_restaurant_fraiches'), ref('categ_restaurant_chaudes'), ref('categ_restaurant_bieres')])]"/>
        </record>
        <record id="station_cafe_bar" model="adk.pos.station">
            <field name="name">Bar</field>
            <field name="pos_type">cafe</field>
