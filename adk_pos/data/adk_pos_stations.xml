<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="station_restaurant_cuisine" model="adk.pos.station">
            <field name="name">Cuisine</field>
            <field name="pos_type">restaurant</field>
            <field name="color">2</field>
            <field name="sequence">1</field>
            <field name="category_ids" eval="[(6, 0, [ref('categ_restaurant_entrees'), ref('categ_restaurant_plats'), ref('categ_restaurant_grillades'), ref('categ_restaurant_desserts')])]"/>
        </record>
        <record id="station_restaurant_bar" model="adk.pos.station">
