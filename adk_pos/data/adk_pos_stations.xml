            <field name="pos_type">fastfood</field>
            <field name="color">4</field>
            <field name="sequence">2</field>
            <field name="category_ids" eval="[(6, 0, [ref('categ_fastfood_desserts'), ref('categ_fastfood_boissons')])]"/>
