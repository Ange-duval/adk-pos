<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ CONFIG 1 : RESTAURANT ============ -->
        <record id="config_restaurant" model="adk.pos.config">
            <field name="name">Restaurant Le Bon Goût</field>
            <field name="quick_note_ids" eval="[(6, 0, [ref('quick_note_no_onion'), ref('quick_note_no_pepper'), ref('quick_note_spicy'), ref('quick_note_well_done'), ref('quick_note_rare'), ref('quick_note_takeaway'), ref('quick_note_allergy'), ref('quick_note_urgent')])]"/>
            <field name="pos_type">restaurant</field>
            <field name="sequence">1</field>
            <field name="payment_method_ids" eval="[(6, 0, [
                ref('payment_method_cash'), ref('payment_method_card'),
                ref('payment_method_mobile'), ref('payment_method_other')])]"/>
        </record>

        <record id="floor_restaurant_interieur" model="adk.pos.floor">
            <field name="name">Salle intérieure</field>
            <field name="config_id" ref="config_restaurant"/>
            <field name="sequence">1</field>
            <field name="background_color">#F5F1EB</field>
        </record>
        <record id="table_ri_1" model="adk.pos.table">
            <field name="name">T1</field><field name="floor_id" ref="floor_restaurant_interieur"/>
            <field name="seats">2</field><field name="shape">round</field><field name="pos_x">60</field><field name="pos_y">70</field><field name="width">110</field><field name="height">110</field></record>
        <record id="table_ri_2" model="adk.pos.table">
            <field name="name">T2</field><field name="floor_id" ref="floor_restaurant_interieur"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">290</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>
        <record id="table_ri_3" model="adk.pos.table">
            <field name="name">T3</field><field name="floor_id" ref="floor_restaurant_interieur"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">520</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>
        <record id="table_ri_4" model="adk.pos.table">
            <field name="name">T4</field><field name="floor_id" ref="floor_restaurant_interieur"/>
            <field name="seats">6</field><field name="shape">rectangle</field><field name="pos_x">750</field><field name="pos_y">70</field><field name="width">220</field><field name="height">130</field></record>
        <record id="table_ri_5" model="adk.pos.table">
            <field name="name">T5</field><field name="floor_id" ref="floor_restaurant_interieur"/>
            <field name="seats">2</field><field name="shape">round</field><field name="pos_x">60</field><field name="pos_y">280</field><field name="width">110</field><field name="height">110</field></record>

        <record id="floor_restaurant_terrasse" model="adk.pos.floor">
            <field name="name">Terrasse</field>
            <field name="config_id" ref="config_restaurant"/>
            <field name="sequence">2</field>
            <field name="background_color">#EAF3EE</field>
        </record>
        <record id="table_rt_1" model="adk.pos.table">
            <field name="name">TR1</field><field name="floor_id" ref="floor_restaurant_terrasse"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">60</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>
        <record id="table_rt_2" model="adk.pos.table">
            <field name="name">TR2</field><field name="floor_id" ref="floor_restaurant_terrasse"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">290</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>
        <record id="table_rt_3" model="adk.pos.table">
            <field name="name">TR3</field><field name="floor_id" ref="floor_restaurant_terrasse"/>
            <field name="seats">2</field><field name="shape">round</field><field name="pos_x">520</field><field name="pos_y">70</field><field name="width">110</field><field name="height">110</field></record>
        <record id="table_rt_4" model="adk.pos.table">
            <field name="name">TR4</field><field name="floor_id" ref="floor_restaurant_terrasse"/>
            <field name="seats">8</field><field name="shape">rectangle</field><field name="pos_x">750</field><field name="pos_y">70</field><field name="width">220</field><field name="height">130</field></record>

        <!-- ============ CONFIG 2 : CAFÉ ============ -->
        <record id="config_cafe" model="adk.pos.config">
            <field name="name">Café Le Central</field>
            <field name="pos_type">cafe</field>
            <field name="sequence">2</field>
            <field name="payment_method_ids" eval="[(6, 0, [
                ref('payment_method_cash'), ref('payment_method_card'),
                ref('payment_method_mobile'), ref('payment_method_other')])]"/>
        </record>

        <record id="floor_cafe_salle" model="adk.pos.floor">
            <field name="name">Salle café</field>
            <field name="config_id" ref="config_cafe"/>
            <field name="sequence">1</field>
            <field name="background_color">#F1EAF5</field>
        </record>
        <record id="table_c_1" model="adk.pos.table">
            <field name="name">C1</field><field name="floor_id" ref="floor_cafe_salle"/>
            <field name="seats">2</field><field name="shape">round</field><field name="pos_x">60</field><field name="pos_y">70</field><field name="width">110</field><field name="height">110</field></record>
        <record id="table_c_2" model="adk.pos.table">
            <field name="name">C2</field><field name="floor_id" ref="floor_cafe_salle"/>
            <field name="seats">2</field><field name="shape">round</field><field name="pos_x">290</field><field name="pos_y">70</field><field name="width">110</field><field name="height">110</field></record>
        <record id="table_c_3" model="adk.pos.table">
            <field name="name">C3</field><field name="floor_id" ref="floor_cafe_salle"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">520</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>
        <record id="table_c_4" model="adk.pos.table">
            <field name="name">C4</field><field name="floor_id" ref="floor_cafe_salle"/>
            <field name="seats">4</field><field name="shape">square</field><field name="pos_x">750</field><field name="pos_y">70</field><field name="width">130</field><field name="height">130</field></record>

        <!-- ============ CONFIG 3 : BOUTIQUE (retail, sans tables) ============ -->
        <record id="config_boutique" model="adk.pos.config">
            <field name="name">Boutique Fashion Store</field>
            <field name="pos_type">retail</field>
            <field name="sequence">3</field>
            <field name="payment_method_ids" eval="[(6, 0, [
                ref('payment_method_cash'), ref('payment_method_card'),
                ref('payment_method_mobile'), ref('payment_method_other')])]"/>
        </record>

    </data>
</odoo>
