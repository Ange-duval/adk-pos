<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_adk_pos_session" model="ir.sequence">
            <field name="name">ADK POS Session</field>
            <field name="code">adk.pos.session</field>
            <field name="prefix">SESS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_adk_pos_order" model="ir.sequence">
            <field name="name">ADK POS Order</field>
            <field name="code">adk.pos.order</field>
            <field name="prefix">CMD/%(year)s%(month)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_adk_pos_reservation" model="ir.sequence">
            <field name="name">ADK POS Réservation</field>
            <field name="code">adk.pos.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
