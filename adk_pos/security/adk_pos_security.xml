<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_adk_pos" model="ir.module.category">
            <field name="name">ADK Point de Vente</field>
            <field name="sequence">15</field>
        </record>

        <!-- ============ GROUPES ============ -->
        <record id="group_adk_pos_server" model="res.groups">
            <field name="name">Serveur</field>
            <field name="category_id" ref="module_category_adk_pos"/>
            <field name="comment">Prend les commandes, gère les tables, consulte les réservations.</field>
        </record>

        <record id="group_adk_pos_cashier" model="res.groups">
            <field name="name">Caissier</field>
            <field name="category_id" ref="module_category_adk_pos"/>
            <field name="implied_ids" eval="[(4, ref('group_adk_pos_server'))]"/>
            <field name="comment">Ouvre/ferme les sessions de caisse, encaisse, rembourse (avec validation manager).</field>
        </record>

        <record id="group_adk_pos_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_adk_pos"/>
            <field name="implied_ids" eval="[(4, ref('group_adk_pos_cashier'))]"/>
            <field name="comment">Accès complet : configuration, analyse, plan de salle, validations (remises, remboursements).</field>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ============ RÈGLES D'ENREGISTREMENT ============ -->

        <!-- Un serveur voit toutes les commandes en cours (pour se relayer) mais seulement ses propres commandes payées -->
        <record id="rule_adk_pos_order_server" model="ir.rule">
            <field name="name">Commandes : Serveur (en cours + les siennes)</field>
            <field name="model_id" ref="model_adk_pos_order"/>
            <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('server_id', '=', user.id), ('state', 'in', ('draft', 'sent', 'billing'))]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server'))]"/>
        </record>

        <record id="rule_adk_pos_order_cashier_manager" model="ir.rule">
            <field name="name">Commandes : Caissier / Manager (tout)</field>
            <field name="model_id" ref="model_adk_pos_order"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_session_company" model="ir.rule">
            <field name="name">Sessions : société</field>
            <field name="model_id" ref="model_adk_pos_session"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_config_all" model="ir.rule">
            <field name="name">Configuration : société</field>
            <field name="model_id" ref="model_adk_pos_config"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_payment_company" model="ir.rule">
            <field name="name">Paiements : société</field>
            <field name="model_id" ref="model_adk_pos_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_reservation_company" model="ir.rule">
            <field name="name">Réservations : société</field>
            <field name="model_id" ref="model_adk_pos_reservation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_table_company" model="ir.rule">
            <field name="name">Tables : société</field>
            <field name="model_id" ref="model_adk_pos_table"/>
            <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_floor_company" model="ir.rule">
            <field name="name">Salles : société</field>
            <field name="model_id" ref="model_adk_pos_floor"/>
            <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

        <record id="rule_adk_pos_kitchen_company" model="ir.rule">
            <field name="name">Cuisine : société</field>
            <field name="model_id" ref="model_adk_pos_kitchen_item"/>
            <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_adk_pos_server')), (4, ref('group_adk_pos_cashier')), (4, ref('group_adk_pos_manager'))]"/>
        </record>

    </data>
</odoo>
