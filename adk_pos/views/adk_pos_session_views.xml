<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_adk_pos_session_search" model="ir.ui.view">
        <field name="name">adk.pos.session.search</field>
        <field name="model">adk.pos.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="config_id"/>
                <field name="cashier_id"/>
                <filter string="Ouvertes" name="opened" domain="[('state', '=', 'opened')]"/>
                <filter string="Fermées" name="closed" domain="[('state', '=', 'closed')]"/>
                <filter string="Avec écart de caisse" name="gap" domain="[('cash_difference', '!=', 0), ('state', '=', 'closed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Point de vente" name="group_config" context="{'group_by': 'config_id'}"/>
                    <filter string="Caissier" name="group_cashier" context="{'group_by': 'cashier_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_adk_pos_session_list" model="ir.ui.view">
        <field name="name">adk.pos.session.list</field>
        <field name="model">adk.pos.session</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'opened'" decoration-muted="state == 'closed'" create="false">
                <field name="name"/>
                <field name="config_id"/>
                <field name="cashier_id"/>
                <field name="opening_date"/>
                <field name="closing_date"/>
                <field name="total_sales" widget="monetary" sum="Total"/>
                <field name="cash_difference" widget="monetary" optional="show"
                       decoration-danger="cash_difference != 0"/>
                <field name="order_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'opened'" decoration-info="state == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_adk_pos_session_form" model="ir.ui.view">
        <field name="name">adk.pos.session.form</field>
        <field name="model">adk.pos.session</field>
        <field name="arch" type="xml">
            <form string="Session de caisse" create="false">
                <header>
                    <button name="action_close_session" type="object" string="Fermer la session"
                            invisible="state not in ('opened', 'closing')"
                            confirm="Fermer cette session ? Pensez à saisir le solde compté avant."
                            groups="adk_pos.group_adk_pos_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="opened,closing,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Commandes"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="total_sales" widget="monetary" nolabel="1"/></span>
                                <span class="o_stat_text">Ventes nettes</span>
                            </div>
                        </button>
                        <button name="action_view_cash_moves" type="object" class="oe_stat_button" icon="fa-inbox">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Caisse</span>
                            </div>
                        </button>
                        <button name="action_print_z_report" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Rapport X/Z</span>
                            </div>
                        </button>
                        <button name="%(action_report_z_pdf)d" type="action" class="oe_stat_button" icon="fa-file-pdf-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">PDF</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="cashier_id" string="Ouvert par" readonly="state != 'opening'"/>
                            <field name="config_id" string="Point de vente" readonly="state != 'opening'"/>
                            <field name="opening_date" string="Date d'ouverture"/>
                            <field name="closing_date" string="Date de clôture"/>
                            <field name="closed_by_id"/>
                        </group>
                        <group string="Espèces">
                            <field name="opening_balance" string="Fond de caisse" readonly="state != 'opening'"/>
                            <field name="cash_payments_total"/>
                            <field name="cash_in_total"/>
                            <field name="cash_out_total"/>
                            <field name="closing_balance_expected" string="Solde théorique"/>
                            <field name="closing_balance_actual" string="Solde compté" readonly="1"/>
                            <field name="cash_difference" string="Écart de caisse"
                                   decoration-danger="cash_difference != 0"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                        </group>
                    </group>
                    <group string="Comptage" invisible="not opening_count_details and not closing_count_details">
                        <field name="opening_count_details"/>
                        <field name="closing_count_details" readonly="1"/>
                        <field name="closing_note" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_adk_pos_session_kanban" model="ir.ui.view">
        <field name="name">adk.pos.session.kanban</field>
        <field name="model">adk.pos.session</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="state"/>
                <field name="total_sales"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong><field name="name"/></strong>
                            <div><field name="config_id"/></div>
                            <div><field name="cashier_id"/></div>
                            <div class="fw-bold"><field name="total_sales" widget="monetary"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_adk_pos_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">adk.pos.session</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_adk_pos_session_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
            Les sessions de caisse s'ouvrent depuis le terminal (menu Point de Vente).
            Cet écran sert à consulter l'historique et imprimer les rapports X/Z.
        </p></field>
    </record>

    <record id="view_adk_pos_cash_move_list" model="ir.ui.view">
        <field name="name">adk.pos.cash.move.list</field>
        <field name="model">adk.pos.cash.move</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="create_date" string="Date"/>
                <field name="move_type" widget="badge"
                       decoration-success="move_type == 'in'" decoration-danger="move_type == 'out'"/>
                <field name="reason"/>
                <field name="user_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

</odoo>
