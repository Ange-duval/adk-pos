<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adk_pos_table_generate_wizard_form" model="ir.ui.view">
        <field name="name">adk.pos.table.generate.wizard.form</field>
        <field name="model">adk.pos.table.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer les tables">
                <group>
                    <field name="floor_id" invisible="1"/>
                    <field name="count"/>
                    <field name="seats"/>
                    <field name="shape" widget="radio" options="{'horizontal': true}"/>
                    <field name="prefix"/>
                    <field name="replace" widget="boolean_toggle"/>
                </group>
                <p class="text-muted">Les tables sont numérotées (T1, T2…) et rangées automatiquement dans la salle.
                    Vous pourrez les renommer et les déplacer ensuite.</p>
                <footer>
                    <button string="Générer" type="object" name="action_generate" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
