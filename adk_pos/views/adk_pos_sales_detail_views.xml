<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adk_pos_sales_detail_wizard" model="ir.ui.view">
        <field name="name">adk.pos.sales.detail.wizard.form</field>
        <field name="model">adk.pos.sales.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Détail des ventes">
                <div class="alert alert-info" role="alert">
                    Choisissez la période et, si besoin, un point de vente, un serveur ou un mode de paiement.
                    <b>Analyse des ventes (PDF)</b> : même présentation que le rapport X/Z, sur la période, sans la liste des commandes
                    (ventes par catégorie et par article, paiements, taxes, analyse).
                    <b>Liste des commandes (PDF)</b> : une ligne par commande, adaptée à des centaines de commandes.
                    La <b>liste</b> permet de filtrer, regrouper et exporter vers Excel.
                </div>
                <group>
                    <group string="Période">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filtres (facultatifs)">
                        <field name="config_ids" widget="many2many_tags"/>
                        <field name="server_ids" widget="many2many_tags"/>
                        <field name="payment_method_ids" widget="many2many_tags"/>
                        <field name="order_type"/>
                    </group>
                </group>
                <group>
                    <group string="Analyse des ventes (PDF)">
                        <field name="products_per_categ"/>
                    </group>
                    <group string="Liste des commandes (PDF)">
                        <field name="group_by"/>
                        <field name="show_lines"/>
                    </group>
                </group>
                <footer>
                    <button string="Analyse des ventes (PDF)" name="action_print_analysis_pdf" type="object" class="btn-primary"/>
                    <button string="Liste des commandes (PDF)" name="action_print_pdf" type="object" class="btn-secondary"/>
                    <button string="Voir la liste / Exporter Excel" name="action_open_list" type="object" class="btn-secondary"/>
                    <button string="Fermer" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_adk_pos_sales_detail_wizard" model="ir.actions.act_window">
        <field name="name">Détail des ventes</field>
        <field name="res_model">adk.pos.sales.detail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_adk_pos_sales_detail" name="Analyse des ventes (PDF / Excel)"
              parent="menu_adk_pos_analyse_root" action="action_adk_pos_sales_detail_wizard" sequence="1"
              groups="adk_pos.group_adk_pos_cashier"/>
</odoo>
